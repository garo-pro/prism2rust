# Pinned submodule for the upstream Prism C/C++ library.
#
# Reproducibility: the EXACT commit every clone checks out is recorded as the
# gitlink in this superproject's tree (see `git submodule status`), NOT here.
# The keys below document the intended pin and make `git submodule update` use
# a plain detached checkout of that recorded commit.
#
# Pinned release: v0.18.3  (stable)
# Pinned commit : 94329ebeccbaee7f70b3494a290c9dfaac0184ee
#
# To move the pin, use the `update-prism` skill (never bump by hand) so the
# gitlink, this file, and PRISM_PIN.toml stay in sync and the bridge is
# regenerated + tested.
[submodule "external/prism"]
	path = external/prism
	url = https://github.com/ethindp/prism
	update = checkout
	shallow = false
