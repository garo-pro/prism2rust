# Normalize line endings so CI (Linux) and Windows dev agree. LF for everything
# text-like; shell scripts MUST be LF to run under bash on the runners.
* text=auto eol=lf

*.sh   text eol=lf
*.rs   text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.h    text eol=lf

# The checked-in FFI is generated by bindgen; keep it out of language stats and
# collapse it in diffs by default (still reviewable via `git diff -- <file>`).
crates/prism-sys/src/bindings_pregenerated.rs linguist-generated=true
